{
  "env": {
    "es2022": true,
    "node": true,
    "browser": false
  },
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "module"
  },
  "rules": {
    "no-unused-vars": "warn",
    "no-console": "off",
    "semi": ["error", "always"],
    "quotes": ["error", "single"],
    "eqeqeq": ["error", "always"]
  },
  "overrides": [
    {
      "files": ["src/renderer/**/*.js"],
      "env": { "browser": true, "node": false }
    }
  ]
}
