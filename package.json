{
  "name": "unireserve",
  "version": "1.0.0",
  "description": "Facility Reservation System \u2013 University of the Assumption",
  "author": "University of the Assumption",
  "license": "MIT",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "lint": "eslint src tests",
    "test": "jest --testPathPattern=tests",
    "postinstall": "node scripts/ensure-sqlite-binary.js",
    "dist": "electron-builder --win",
    "dist:portable": "electron-builder --win portable",
    "dist:turnover": "node scripts/prepare-turnover.js",
    "dist:all": "electron-builder --win --linux --mac"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.11.1",
    "electron-window-state": "^5.0.3"
  },
  "devDependencies": {
    "electron": "^35.7.5",
    "electron-builder": "^25.1.8",
    "eslint": "^8.57.1",
    "jest": "^29.7.0"
  },
  "build": {
    "appId": "ph.edu.ua.unireserve",
    "productName": "UniReserve",
    "copyright": "University of the Assumption",
    "icon": "src/renderer/assets/ua-logo.png",
    "asar": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "!src/renderer/node_modules/**"
    ],
    "win": {
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "icon": "build/icon.ico",
      "category": "Education"
    },
    "mac": {
      "target": ["dmg"],
      "icon": "build/icon.icns",
      "category": "public.app-category.education"
    }
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": ["**/tests/**/*.test.js"],
    "testPathIgnorePatterns": ["/node_modules/", "/dist/"]
  },
  "allowScripts": {
    "electron@35.7.5": true,
    "better-sqlite3@12.11.1": true
  }
}
